# SHAKARA needs no API keys or secrets. These are the only settings, all optional.
# Copy to .env (never committed; .gitignore keeps it out) or set them in your host's dashboard.

# Port the server listens on (most hosts set this for you)
PORT=8080

# Local testing only: add this many ms of fake delay each way (125 = about 250 ms ping)
SIM_LAG_MS=0
